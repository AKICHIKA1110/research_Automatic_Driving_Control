<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>a1_bringup</name>
  <version>0.0.0</version>
  <description>Launch files for the A1 Ackermann car (manual driving and rosbag data collection)</description>
  <maintainer email="128462874+AKICHIKA1110@users.noreply.github.com">akichika</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>ros_robot_controller</exec_depend>
  <exec_depend>a1_control</exec_depend>
  <exec_depend>a1_vehicle</exec_depend>
  <exec_depend>ascamera</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
